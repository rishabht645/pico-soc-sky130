library (sram_4k_final_SS_1p6V_100C_lib){
    delay_model : "table_lookup";
    time_unit : "1ns" ;
    voltage_unit : "1V" ;
    current_unit : "1mA" ;
    resistance_unit : "1kohm" ;
    capacitive_load_unit(1, pF) ;
    leakage_power_unit : "1mW" ;
    pulling_resistance_unit : "1kohm" ;
    operating_conditions(OC){
    process : 1.0 ;
    voltage : 1.6 ;
    temperature : 100;
    }

    input_threshold_pct_fall       :  50.0 ;
    output_threshold_pct_fall      :  50.0 ;
    input_threshold_pct_rise       :  50.0 ;
    output_threshold_pct_rise      :  50.0 ;
    slew_lower_threshold_pct_fall  :  10.0 ;
    slew_upper_threshold_pct_fall  :  90.0 ;
    slew_lower_threshold_pct_rise  :  10.0 ;
    slew_upper_threshold_pct_rise  :  90.0 ;

    nom_voltage : 1.6;
    nom_temperature : 100;
    nom_process : 1.0;
    default_cell_leakage_power    : 0.0 ;
    default_leakage_power_density : 0.0 ;
    default_input_pin_cap    : 1.0 ;
    default_inout_pin_cap    : 1.0 ;
    default_output_pin_cap   : 0.0 ;
    default_max_transition   : 0.32 ;
    default_fanout_load      : 1.0 ;
    default_max_fanout   : 4.0 ;
    default_connection_class : universal ;

    voltage_map ( VCCD1, 1.6 );
    voltage_map ( VSSD1, 0 );

    lu_table_template(CELL_TABLE){
        variable_1 : input_net_transition;
        variable_2 : total_output_net_capacitance;
        index_1("0.032, 0.16, 0.32");
        index_2("0.0017225, 0.00689, 0.02756");
    }

    lu_table_template(CONSTRAINT_TABLE){
        variable_1 : related_pin_transition;
        variable_2 : constrained_pin_transition;
        index_1("0.032, 0.16, 0.32");
        index_2("0.032, 0.16, 0.32");
    }

    default_operating_conditions : OC; 


    type (data){
    base_type : array;
    data_type : bit;
    bit_width : 33;
    bit_from : 32;
    bit_to : 0;
    }

    type (addr){
    base_type : array;
    data_type : bit;
    bit_width : 11;
    bit_from : 10;
    bit_to : 0;
    }

    type (wmask){
    base_type : array;
    data_type : bit;
    bit_width : 4;
    bit_from : 3;
    bit_to : 0;
    }

cell (sram_4k_final){
    memory(){ 
    type : ram;
    address_width : 11;
    word_width : 32;
    }
    interface_timing : true;
    dont_use  : true;
    map_only   : true;
    dont_touch : true;
    area : 256920.40327500002;

    pg_pin(vccd1) {
         voltage_name : VCCD1;
         pg_type : primary_power;
    }

    pg_pin(vssd1) {
         voltage_name : VSSD1;
         pg_type : primary_ground;
    }

    leakage_power () {
      value : 0.2859058;
    }
    cell_leakage_power : 0.2859058;
    bus(din0){
        bus_type  : data; 
        direction  : input; 
        capacitance : 0.006889999999999999;  
        memory_write(){ 
            address : addr0; 
            clocked_on  : clk0; 
        }
        pin(din0[31:0]){
        timing(){ 
            timing_type : setup_rising; 
            related_pin  : "clk0"; 
            rise_constraint(CONSTRAINT_TABLE) {
            values("0.188, 0.212, 0.261",\
                   "0.139, 0.188, 0.212",\
                   "0.115, 0.164, 0.212");
            }
            fall_constraint(CONSTRAINT_TABLE) {
            values("0.139, 0.164, 0.212",\
                   "0.164, 0.188, 0.237",\
                   "0.188, 0.237, 0.261");
            }
        }
        timing(){ 
            timing_type : hold_rising; 
            related_pin  : "clk0"; 
            rise_constraint(CONSTRAINT_TABLE) {
            values("-0.105, -0.154, -0.178",\
                   "-0.129, -0.178, -0.203",\
                   "-0.178, -0.227, -0.251");
              }
            fall_constraint(CONSTRAINT_TABLE) {
            values("-0.081, -0.105, -0.154",\
                   "-0.032, -0.081, -0.129",\
                   "-0.007, -0.056, -0.081");
            }
        }
        }
    
        pin(din0[32]) { direction : input; }
}
    bus(dout0){
        bus_type  : data; 
        direction  : output; 
        max_transition : 2.624;
        max_capacitance : 0.027559999999999998;  
        min_capacitance : 0.0017224999999999999;  
        memory_read(){ 
            address : addr0; 
        }
        pin(dout0[31:0]){
        timing(){ 
            timing_sense : non_unate; 
            related_pin : "clk0"; 
            timing_type : falling_edge; 
            cell_rise(CELL_TABLE) {
            values("3.369, 3.804, 5.303",\
                   "3.409, 3.844, 5.343",\
                   "3.444, 3.879, 5.379");
            }
            cell_fall(CELL_TABLE) {
            values("3.369, 3.804, 5.303",\
                   "3.409, 3.844, 5.343",\
                   "3.444, 3.879, 5.379");
            }
            rise_transition(CELL_TABLE) {
            values("0.791, 1.472, 2.178",\
                   "0.791, 1.472, 2.178",\
                   "0.791, 1.472, 2.178");
            }
            fall_transition(CELL_TABLE) {
            values("0.535, 1.059, 2.614",\
                   "0.536, 1.061, 2.616",\
                   "0.541, 1.066, 2.624");
            }
        }
        }
    
        pin(dout0[32]) { direction : output; }
}

    bus(addr0){
        bus_type  : addr; 
        direction  : input; 
        capacitance : 0.006889999999999999;  
        max_transition       : 0.32;
        pin(addr0[10:0]){
        timing(){ 
            timing_type : setup_rising; 
            related_pin  : "clk0"; 
            rise_constraint(CONSTRAINT_TABLE) {
            values("0.188, 0.212, 0.261",\
                   "0.139, 0.188, 0.212",\
                   "0.115, 0.164, 0.212");
            }
            fall_constraint(CONSTRAINT_TABLE) {
            values("0.139, 0.164, 0.212",\
                   "0.164, 0.188, 0.237",\
                   "0.188, 0.237, 0.261");
            }
        }
        timing(){ 
            timing_type : hold_rising; 
            related_pin  : "clk0"; 
            rise_constraint(CONSTRAINT_TABLE) {
            values("-0.105, -0.154, -0.178",\
                   "-0.129, -0.178, -0.203",\
                   "-0.178, -0.227, -0.251");
              }
            fall_constraint(CONSTRAINT_TABLE) {
            values("-0.081, -0.105, -0.154",\
                   "-0.032, -0.081, -0.129",\
                   "-0.007, -0.056, -0.081");
            }
        }
        }
    }

    bus(wmask0){
        bus_type  : wmask; 
        direction  : input; 
        capacitance : 0.006889999999999999;  
        max_transition       : 0.32;
        pin(wmask0[3:0]){
        timing(){ 
            timing_type : setup_rising; 
            related_pin  : "clk0"; 
            rise_constraint(CONSTRAINT_TABLE) {
            values("0.188, 0.212, 0.261",\
                   "0.139, 0.188, 0.212",\
                   "0.115, 0.164, 0.212");
            }
            fall_constraint(CONSTRAINT_TABLE) {
            values("0.139, 0.164, 0.212",\
                   "0.164, 0.188, 0.237",\
                   "0.188, 0.237, 0.261");
            }
        }
        timing(){ 
            timing_type : hold_rising; 
            related_pin  : "clk0"; 
            rise_constraint(CONSTRAINT_TABLE) {
            values("-0.105, -0.154, -0.178",\
                   "-0.129, -0.178, -0.203",\
                   "-0.178, -0.227, -0.251");
              }
            fall_constraint(CONSTRAINT_TABLE) {
            values("-0.081, -0.105, -0.154",\
                   "-0.032, -0.081, -0.129",\
                   "-0.007, -0.056, -0.081");
            }
        }
        }
    }

    pin(csb0){
        direction  : input; 
        capacitance : 0.006889999999999999;  
        timing(){ 
            timing_type : setup_rising; 
            related_pin  : "clk0"; 
            rise_constraint(CONSTRAINT_TABLE) {
            values("0.188, 0.212, 0.261",\
                   "0.139, 0.188, 0.212",\
                   "0.115, 0.164, 0.212");
            }
            fall_constraint(CONSTRAINT_TABLE) {
            values("0.139, 0.164, 0.212",\
                   "0.164, 0.188, 0.237",\
                   "0.188, 0.237, 0.261");
            }
        }
        timing(){ 
            timing_type : hold_rising; 
            related_pin  : "clk0"; 
            rise_constraint(CONSTRAINT_TABLE) {
            values("-0.105, -0.154, -0.178",\
                   "-0.129, -0.178, -0.203",\
                   "-0.178, -0.227, -0.251");
              }
            fall_constraint(CONSTRAINT_TABLE) {
            values("-0.081, -0.105, -0.154",\
                   "-0.032, -0.081, -0.129",\
                   "-0.007, -0.056, -0.081");
            }
        }
    }

    pin(web0){
        direction  : input; 
        capacitance : 0.006889999999999999;  
        timing(){ 
            timing_type : setup_rising; 
            related_pin  : "clk0"; 
            rise_constraint(CONSTRAINT_TABLE) {
            values("0.188, 0.212, 0.261",\
                   "0.139, 0.188, 0.212",\
                   "0.115, 0.164, 0.212");
            }
            fall_constraint(CONSTRAINT_TABLE) {
            values("0.139, 0.164, 0.212",\
                   "0.164, 0.188, 0.237",\
                   "0.188, 0.237, 0.261");
            }
        }
        timing(){ 
            timing_type : hold_rising; 
            related_pin  : "clk0"; 
            rise_constraint(CONSTRAINT_TABLE) {
            values("-0.105, -0.154, -0.178",\
                   "-0.129, -0.178, -0.203",\
                   "-0.178, -0.227, -0.251");
              }
            fall_constraint(CONSTRAINT_TABLE) {
            values("-0.081, -0.105, -0.154",\
                   "-0.032, -0.081, -0.129",\
                   "-0.007, -0.056, -0.081");
            }
        }
    }

    pin(clk0){
        clock             : true;
        direction  : input; 
        capacitance : 0.006889999999999999;  
        internal_power(){
            when : "!csb0 & !web0"; 
            rise_power(scalar){
                values("1.407880e+00");
            }
            fall_power(scalar){
                values("1.690535e+00");
            }
        }
        internal_power(){
            when : "csb0 & !web0"; 
            rise_power(scalar){
                values("8.452930e-01");
            }
            fall_power(scalar){
                values("6.538921e-01");
            }
        }
        internal_power(){
            when : "!csb0 & web0"; 
            rise_power(scalar){
                values("1.413150e+00");
            }
            fall_power(scalar){
                values("1.401903e+00");
            }
        }
        internal_power(){
            when : "csb0 & web0"; 
            rise_power(scalar){
                values("6.274492e-01");
            }
            fall_power(scalar){
                values("6.503117e-01");
            }
        }
        timing(){ 
            timing_type : "min_pulse_width"; 
            related_pin  : clk0; 
            rise_constraint(scalar) {
                values("5.469"); 
            }
            fall_constraint(scalar) {
                values("5.469"); 
            }
         }
        timing(){ 
            timing_type : "minimum_period"; 
            related_pin  : clk0; 
            rise_constraint(scalar) {
                values("10.938"); 
            }
            fall_constraint(scalar) {
                values("10.938"); 
            }
         }
    }

    
    pin(spare_wen0) { direction : input; }
}
}
