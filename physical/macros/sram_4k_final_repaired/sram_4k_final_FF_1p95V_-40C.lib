library (sram_4k_final_FF_1p95V_-40C_lib){
    delay_model : "table_lookup";
    time_unit : "1ns" ;
    voltage_unit : "1V" ;
    current_unit : "1mA" ;
    resistance_unit : "1kohm" ;
    capacitive_load_unit(1, pF) ;
    leakage_power_unit : "1mW" ;
    pulling_resistance_unit : "1kohm" ;
    operating_conditions(OC){
    process : 1.0 ;
    voltage : 1.95 ;
    temperature : -40;
    }

    input_threshold_pct_fall       :  50.0 ;
    output_threshold_pct_fall      :  50.0 ;
    input_threshold_pct_rise       :  50.0 ;
    output_threshold_pct_rise      :  50.0 ;
    slew_lower_threshold_pct_fall  :  10.0 ;
    slew_upper_threshold_pct_fall  :  90.0 ;
    slew_lower_threshold_pct_rise  :  10.0 ;
    slew_upper_threshold_pct_rise  :  90.0 ;

    nom_voltage : 1.95;
    nom_temperature : -40;
    nom_process : 1.0;
    default_cell_leakage_power    : 0.0 ;
    default_leakage_power_density : 0.0 ;
    default_input_pin_cap    : 1.0 ;
    default_inout_pin_cap    : 1.0 ;
    default_output_pin_cap   : 0.0 ;
    default_max_transition   : 0.32 ;
    default_fanout_load      : 1.0 ;
    default_max_fanout   : 4.0 ;
    default_connection_class : universal ;

    voltage_map ( VCCD1, 1.95 );
    voltage_map ( VSSD1, 0 );

    lu_table_template(CELL_TABLE){
        variable_1 : input_net_transition;
        variable_2 : total_output_net_capacitance;
        index_1("0.032, 0.16, 0.32");
        index_2("0.0017225, 0.00689, 0.02756");
    }

    lu_table_template(CONSTRAINT_TABLE){
        variable_1 : related_pin_transition;
        variable_2 : constrained_pin_transition;
        index_1("0.032, 0.16, 0.32");
        index_2("0.032, 0.16, 0.32");
    }

    default_operating_conditions : OC; 


    type (data){
    base_type : array;
    data_type : bit;
    bit_width : 33;
    bit_from : 32;
    bit_to : 0;
    }

    type (addr){
    base_type : array;
    data_type : bit;
    bit_width : 11;
    bit_from : 10;
    bit_to : 0;
    }

    type (wmask){
    base_type : array;
    data_type : bit;
    bit_width : 4;
    bit_from : 3;
    bit_to : 0;
    }

cell (sram_4k_final){
    memory(){ 
    type : ram;
    address_width : 11;
    word_width : 32;
    }
    interface_timing : true;
    dont_use  : true;
    map_only   : true;
    dont_touch : true;
    area : 256920.40327500002;

    pg_pin(vccd1) {
         voltage_name : VCCD1;
         pg_type : primary_power;
    }

    pg_pin(vssd1) {
         voltage_name : VSSD1;
         pg_type : primary_ground;
    }

    leakage_power () {
      value : 2.135027;
    }
    cell_leakage_power : 2.135027;
    bus(din0){
        bus_type  : data; 
        direction  : input; 
        capacitance : 0.006889999999999999;  
        memory_write(){ 
            address : addr0; 
            clocked_on  : clk0; 
        }
        pin(din0[31:0]){
        timing(){ 
            timing_type : setup_rising; 
            related_pin  : "clk0"; 
            rise_constraint(CONSTRAINT_TABLE) {
            values("0.066, 0.09, 0.09",\
                   "0.066, 0.09, 0.09",\
                   "0.066, 0.09, 0.115");
            }
            fall_constraint(CONSTRAINT_TABLE) {
            values("0.066, 0.09, 0.115",\
                   "0.09, 0.115, 0.139",\
                   "0.115, 0.139, 0.164");
            }
        }
        timing(){ 
            timing_type : hold_rising; 
            related_pin  : "clk0"; 
            rise_constraint(CONSTRAINT_TABLE) {
            values("-0.056, -0.081, -0.105",\
                   "-0.081, -0.105, -0.129",\
                   "-0.105, -0.129, -0.154");
              }
            fall_constraint(CONSTRAINT_TABLE) {
            values("-0.032, -0.056, -0.056",\
                   "-0.007, -0.032, -0.032",\
                   "-0.007, -0.032, -0.032");
            }
        }
        }
    
        pin(din0[32]) { direction : input; }
}
    bus(dout0){
        bus_type  : data; 
        direction  : output; 
        max_transition : 0.691;
        max_capacitance : 0.027559999999999998;  
        min_capacitance : 0.0017224999999999999;  
        memory_read(){ 
            address : addr0; 
        }
        pin(dout0[31:0]){
        timing(){ 
            timing_sense : non_unate; 
            related_pin : "clk0"; 
            timing_type : falling_edge; 
            cell_rise(CELL_TABLE) {
            values("1.329, 1.417, 1.724",\
                   "1.352, 1.439, 1.747",\
                   "1.37, 1.457, 1.765");
            }
            cell_fall(CELL_TABLE) {
            values("1.329, 1.417, 1.724",\
                   "1.352, 1.439, 1.747",\
                   "1.37, 1.457, 1.765");
            }
            rise_transition(CELL_TABLE) {
            values("0.686, 0.68, 0.69",\
                   "0.687, 0.681, 0.691",\
                   "0.686, 0.68, 0.69");
            }
            fall_transition(CELL_TABLE) {
            values("0.031, 0.055, 0.151",\
                   "0.031, 0.055, 0.151",\
                   "0.03, 0.055, 0.151");
            }
        }
        }
    
        pin(dout0[32]) { direction : output; }
}

    bus(addr0){
        bus_type  : addr; 
        direction  : input; 
        capacitance : 0.006889999999999999;  
        max_transition       : 0.32;
        pin(addr0[10:0]){
        timing(){ 
            timing_type : setup_rising; 
            related_pin  : "clk0"; 
            rise_constraint(CONSTRAINT_TABLE) {
            values("0.066, 0.09, 0.09",\
                   "0.066, 0.09, 0.09",\
                   "0.066, 0.09, 0.115");
            }
            fall_constraint(CONSTRAINT_TABLE) {
            values("0.066, 0.09, 0.115",\
                   "0.09, 0.115, 0.139",\
                   "0.115, 0.139, 0.164");
            }
        }
        timing(){ 
            timing_type : hold_rising; 
            related_pin  : "clk0"; 
            rise_constraint(CONSTRAINT_TABLE) {
            values("-0.056, -0.081, -0.105",\
                   "-0.081, -0.105, -0.129",\
                   "-0.105, -0.129, -0.154");
              }
            fall_constraint(CONSTRAINT_TABLE) {
            values("-0.032, -0.056, -0.056",\
                   "-0.007, -0.032, -0.032",\
                   "-0.007, -0.032, -0.032");
            }
        }
        }
    }

    bus(wmask0){
        bus_type  : wmask; 
        direction  : input; 
        capacitance : 0.006889999999999999;  
        max_transition       : 0.32;
        pin(wmask0[3:0]){
        timing(){ 
            timing_type : setup_rising; 
            related_pin  : "clk0"; 
            rise_constraint(CONSTRAINT_TABLE) {
            values("0.066, 0.09, 0.09",\
                   "0.066, 0.09, 0.09",\
                   "0.066, 0.09, 0.115");
            }
            fall_constraint(CONSTRAINT_TABLE) {
            values("0.066, 0.09, 0.115",\
                   "0.09, 0.115, 0.139",\
                   "0.115, 0.139, 0.164");
            }
        }
        timing(){ 
            timing_type : hold_rising; 
            related_pin  : "clk0"; 
            rise_constraint(CONSTRAINT_TABLE) {
            values("-0.056, -0.081, -0.105",\
                   "-0.081, -0.105, -0.129",\
                   "-0.105, -0.129, -0.154");
              }
            fall_constraint(CONSTRAINT_TABLE) {
            values("-0.032, -0.056, -0.056",\
                   "-0.007, -0.032, -0.032",\
                   "-0.007, -0.032, -0.032");
            }
        }
        }
    }

    pin(csb0){
        direction  : input; 
        capacitance : 0.006889999999999999;  
        timing(){ 
            timing_type : setup_rising; 
            related_pin  : "clk0"; 
            rise_constraint(CONSTRAINT_TABLE) {
            values("0.066, 0.09, 0.09",\
                   "0.066, 0.09, 0.09",\
                   "0.066, 0.09, 0.115");
            }
            fall_constraint(CONSTRAINT_TABLE) {
            values("0.066, 0.09, 0.115",\
                   "0.09, 0.115, 0.139",\
                   "0.115, 0.139, 0.164");
            }
        }
        timing(){ 
            timing_type : hold_rising; 
            related_pin  : "clk0"; 
            rise_constraint(CONSTRAINT_TABLE) {
            values("-0.056, -0.081, -0.105",\
                   "-0.081, -0.105, -0.129",\
                   "-0.105, -0.129, -0.154");
              }
            fall_constraint(CONSTRAINT_TABLE) {
            values("-0.032, -0.056, -0.056",\
                   "-0.007, -0.032, -0.032",\
                   "-0.007, -0.032, -0.032");
            }
        }
    }

    pin(web0){
        direction  : input; 
        capacitance : 0.006889999999999999;  
        timing(){ 
            timing_type : setup_rising; 
            related_pin  : "clk0"; 
            rise_constraint(CONSTRAINT_TABLE) {
            values("0.066, 0.09, 0.09",\
                   "0.066, 0.09, 0.09",\
                   "0.066, 0.09, 0.115");
            }
            fall_constraint(CONSTRAINT_TABLE) {
            values("0.066, 0.09, 0.115",\
                   "0.09, 0.115, 0.139",\
                   "0.115, 0.139, 0.164");
            }
        }
        timing(){ 
            timing_type : hold_rising; 
            related_pin  : "clk0"; 
            rise_constraint(CONSTRAINT_TABLE) {
            values("-0.056, -0.081, -0.105",\
                   "-0.081, -0.105, -0.129",\
                   "-0.105, -0.129, -0.154");
              }
            fall_constraint(CONSTRAINT_TABLE) {
            values("-0.032, -0.056, -0.056",\
                   "-0.007, -0.032, -0.032",\
                   "-0.007, -0.032, -0.032");
            }
        }
    }

    pin(clk0){
        clock             : true;
        direction  : input; 
        capacitance : 0.006889999999999999;  
        internal_power(){
            when : "!csb0 & !web0"; 
            rise_power(scalar){
                values("7.347479e+00");
            }
            fall_power(scalar){
                values("8.534482e+00");
            }
        }
        internal_power(){
            when : "csb0 & !web0"; 
            rise_power(scalar){
                values("5.434139e+00");
            }
            fall_power(scalar){
                values("3.234280e+00");
            }
        }
        internal_power(){
            when : "!csb0 & web0"; 
            rise_power(scalar){
                values("8.118532e+00");
            }
            fall_power(scalar){
                values("7.471879e+00");
            }
        }
        internal_power(){
            when : "csb0 & web0"; 
            rise_power(scalar){
                values("3.147428e+00");
            }
            fall_power(scalar){
                values("3.289251e+00");
            }
        }
        timing(){ 
            timing_type : "min_pulse_width"; 
            related_pin  : clk0; 
            rise_constraint(scalar) {
                values("1.797"); 
            }
            fall_constraint(scalar) {
                values("1.797"); 
            }
         }
        timing(){ 
            timing_type : "minimum_period"; 
            related_pin  : clk0; 
            rise_constraint(scalar) {
                values("3.594"); 
            }
            fall_constraint(scalar) {
                values("3.594"); 
            }
         }
    }

    
    pin(spare_wen0) { direction : input; }
}
}
